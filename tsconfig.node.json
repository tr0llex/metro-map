{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  // scripts/** обязаны проверяться: там живёт система оценки качества схемы
  // (13 модулей). Пока сюда входил только vite.config.ts, `tsc -b` давал
  // зелёный отчёт, не заглядывая в них вообще.
  "include": ["vite.config.ts", "scripts/**/*.ts", "scripts/**/*.mts"]
}
