{
  "name": "metro-map",
  "private": true,
  "description": "Offline-first route planner for the Moscow Metro: canvas diagram from a Go layout solver, on-device routing, PWA.",
  "keywords": [
    "moscow-metro",
    "metro-map",
    "transit-diagram",
    "octolinear-layout",
    "canvas",
    "pwa",
    "offline-first",
    "route-planning",
    "react",
    "typescript"
  ],
  "homepage": "https://metro.samoy.love",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tr0llex/metro-map.git"
  },
  "bugs": "https://github.com/tr0llex/metro-map/issues",
  "author": "Alexey Samoylov <alex@samoy.love>",
  "license": "MIT",
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pwa": "vite --mode pwa",
    "dev:editor": "vite --mode editor",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/metro-icon-maskable.svg",
    "build:data": "cd go-layout-solver && go run . -data ../data -out ../normalized/fullGraph.json",
    "quality": "tsx scripts/quality/analyze.ts",
    "quality:check": "tsx scripts/quality/analyze.ts --check",
    "check:bundle": "node scripts/check-prod-bundle.mjs",
    "check:css": "node scripts/check-css-tokens.mjs",
    "test:unit": "vitest run --coverage --exclude \"**/labelLayoutRepeat.test.ts\"",
    "test:repeat": "vitest run scripts/quality/labelLayoutRepeat.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "^0.35.3"
  }
}
