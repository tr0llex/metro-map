# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dev-dist
dist-ssr
*.local

# Артефакт MSYS-бага с путями Docker: `-v /c/repo/dist:/app/dist` в Git Bash
# превращалось в `C:/repo/dist;C:/app/dist`, и docker создавал пустой каталог
# `dist;C`. Баг обойдён в tools/visual-qa/run.sh, но страховка дешевле разбора.
dist;C*

# Скриншоты визуальной приёмки: рабочий прогон, а не документ (tools/visual-qa)
.visual-qa/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Go build artifacts
go-layout-solver/*.exe
go-layout-solver/metro_layout_solver

# Локальные настройки запуска Claude Code
.claude/

# Артефакты ревью (скриншоты и пробники) — рабочий мусор, не версионируем
.review-*

# Рабочие каталоги агентов (скриншоты, пробники) — воспроизводятся стендом
.fix-*
.visual-qa

# Отчёт покрытия: генерируется `vitest --coverage`, в CI уходит артефактом в Codecov.
coverage

# Артефакты Playwright: отчёт и трассы падений сквозных тестов
test-results/
playwright-report/

# Рабочие копии агента: полная копия дерева, включая .github/workflows.
# Не исполняется, но ломает поиск и аудит — grep находит вторые экземпляры
# конфигов и workflow. Каталог временный, в истории ему делать нечего.
.claude/worktrees/
