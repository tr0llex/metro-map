# Описание цели выкатки metro.samoy.love.
# Читают и CI (reusable workflow из deploy-kit), и локальный
# `deploy-kit/bin/deploy --config .deploy-kit/prod.env`.

APP=metro
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

ROOT=/var/www/metro
OWNER=www-data:www-data

NGINX_RELOAD=1
# Конфиг сайта живёт в deploy-kit — путь считается от корня ТОГО репозитория.
# Читают обе выкатки, локальная и пайплайн; применяет nginx-apply.sh на сервере
# с бэкапом, nginx -t и откатом. Без NGINX_CONF пара «куда ставить» стояла тут
# в одиночку и не применяла ничего: конфиг на прод не доезжал ни одним путём.
NGINX_CONF=nginx/sites/metro.conf
NGINX_DEST=/etc/nginx/sites-available/metro.conf

HEALTH=https://metro.samoy.love/
VERSION_URL=https://metro.samoy.love/version.json

NEIGHBOURS=samoy.love,snakes.samoy.love,launcher.samoy.love,status.samoy.love

KEEP=5

# О релизе объявляет бот samoy-status, а не CI. Агент опрашивает
# /version.json каждую минуту, видит смену версии и пишет в чат сам — поэтому
# сообщения приходят, хотя TELEGRAM_BOT_TOKEN задан ровно в одном репозитории
# из шести. Если завести токен и здесь, на каждый релиз придёт ДВА сообщения
# об одном и том же. Голос остаётся один — бот, а выкатка молчит осознанно.
# Молчание задаётся здесь, а не отсутствием секрета: пустой секрет пайплайн
# считает недосмотром и ругается предупреждением «о релизе никто не узнал».
# NOTIFY=never он проверяет РАНЬШЕ токена, поэтому предупреждения не будет.
NOTIFY=never

# ------------------------------------------------------------ локальный запуск
#
# Ключи RUN_* читает `dk run` — локальный двойник выкатки. Живут они здесь, а
# не в отдельном файле, ровно по той причине, по которой цель описывается
# одним файлом: два реестра однажды разъедутся, и «добавили файл — появилась
# цель» перестанет быть правдой.
RUN_CMD="npm run dev -- --port %PORT% --strictPort"
RUN_PORT=5173

# --strictPort не украшение. Vite при занятом порте МОЛЧА уезжает на соседний,
# и при запуске нескольких сайтов разом карта оказывается не там, где её ждут
# ссылки и e2e. Порт этой цели совпадает с .claude/launch.json — 5173 занят
# метро, игра die-game сидит на 5175 именно поэтому.
