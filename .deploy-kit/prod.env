# Описание цели выкатки metro.samoy.love.
# Читают и CI (reusable workflow из deploy-kit), и локальный
# `deploy-kit/bin/deploy --config .deploy-kit/prod.env`.

APP=metro
BUILD_CMD="npm ci && npm run build"
ARTIFACT_DIR=dist

ROOT=/var/www/metro
OWNER=www-data:www-data

NGINX_RELOAD=1
# Конфиг сайта живёт в deploy-kit — путь считается от корня ТОГО репозитория.
# Читают обе выкатки, локальная и пайплайн; применяет nginx-apply.sh на сервере
# с бэкапом, nginx -t и откатом. Без NGINX_CONF пара «куда ставить» стояла тут
# в одиночку и не применяла ничего: конфиг на прод не доезжал ни одним путём.
NGINX_CONF=nginx/sites/metro.conf
NGINX_DEST=/etc/nginx/sites-available/metro.conf

HEALTH=https://metro.samoy.love/
VERSION_URL=https://metro.samoy.love/version.json

NEIGHBOURS=samoy.love,snakes.samoy.love,launcher.samoy.love,status.samoy.love

KEEP=5
