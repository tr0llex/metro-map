# Цель: локальный редактор схемы (vite --mode editor, src/editor-main.tsx).
# ТОЛЬКО ЛОКАЛЬНАЯ — редактор пишет прямо в файлы репозитория через
# editorApiPlugin и на сервер не едет вовсе: LOCAL_ONLY=1, `dk`, `dk list`
# и `dk deploy --all` цель не видят, `dk run` видит.
APP=metro-editor
LOCAL_ONLY=1

# ------------------------------------------------------------ локальный запуск
#
# Порт отдельный от основной цели metro (5173), чтобы обе можно было поднять
# разом: dk run metro metro-editor.
RUN_CMD="npm run dev:editor -- --port %PORT% --strictPort"
RUN_PORT=5174
